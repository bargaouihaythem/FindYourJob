@startuml uc_recrutement
!include skin.iuml
!pragma layout smetana
left to right direction

actor "Responsable RH" as RH
actor "Manager" as MGR

rectangle "Plateforme JOB4YOU — Processus de Recrutement & Évaluation" {
  usecase "Publier / gérer une offre" as UC_OFFRE
  usecase "Consulter les candidatures" as UC_FILTRER
  usecase "Corriger le score IA" as UC_SCORE
  usecase "Entretien téléphonique" as UC_PHONE
  usecase "Planifier un entretien" as UC_PLANIF
  usecase "Saisir un feedback" as UC_FEEDBACK
  usecase "Valider un feedback" as UC_VALIDFB
  usecase "Émettre un avis" as UC_AVIS
  usecase "Contresigner la décision" as UC_DECISION
  usecase "Valider l'éligibilité" as UC_CHECK
  usecase "Notifier par e-mail" as UC_NOTIF
}

RH --> UC_OFFRE
RH --> UC_FILTRER
RH --> UC_SCORE
RH --> UC_PHONE
RH --> UC_PLANIF
RH --> UC_FEEDBACK
RH --> UC_VALIDFB
RH --> UC_DECISION

MGR --> UC_FILTRER
MGR --> UC_PLANIF
MGR --> UC_FEEDBACK
MGR --> UC_AVIS

UC_PLANIF ..> UC_CHECK : <<include>>
UC_AVIS ..> UC_CHECK : <<include>>
UC_DECISION ..> UC_CHECK : <<include>>
UC_PLANIF ..> UC_NOTIF : <<include>>
UC_DECISION ..> UC_NOTIF : <<include>>
UC_VALIDFB ..> UC_NOTIF : <<include>>

note top of UC_OFFRE
  La saisie d'un feedback est ouverte au RH, au Manager et
  à l'Admin ; sa validation (/approve, /reject,
  /send-to-candidate) est réservée au RH et à l'Admin.
  Le manager n'écrit qu'un avis sur un dossier déjà en
  évaluation : il alerte le RH, seul à trancher. Le
  contreseing (HIRED avec date de présentation des
  documents, REJECTED avec motif) déclenche l'e-mail de
  décision au candidat — sauf quand le RH confirme un
  refus déjà notifié par l'IA. La surcharge du score IA
  (PATCH /ai-score/override) est ouverte à l'Admin.
  « Valider l'éligibilité » = contrôle serveur de la
  transition de statut avant toute action RH.
end note
@enduml
