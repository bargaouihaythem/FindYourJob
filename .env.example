# Base de données
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/job4you_db
SPRING_DATASOURCE_USERNAME=job4you_user
SPRING_DATASOURCE_PASSWORD=change-me
JPA_DDL_AUTO=update

# Sécurité
# Minimum 32 octets après décodage Base64 ; générer une valeur unique par environnement.
APP_JWT_SECRET=<base64-secret-long-et-aléatoire>
APP_JWT_EXPIRATION=86400000
APP_CORS_ALLOWED_ORIGINS=http://localhost:4200

# Profil et persistance
SPRING_PROFILES_ACTIVE=prod
JPA_DDL_AUTO=validate
APP_FILE_UPLOAD_DIR=uploads/cvs

# Email
APP_EMAIL_ENABLED=false
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=465
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# n8n
N8N_WEBHOOK_AGENT1=http://localhost:5678/webhook/agent1-cv-parser
N8N_WEBHOOK_AGENT2=http://localhost:5678/webhook/agent2-entretien
N8N_WEBHOOK_AGENT3=http://localhost:5678/webhook/agent3-rh-manager
# Requis pour les appels n8n vers Spring Boot ; laisser vide désactive les agents.
N8N_API_KEY=
N8N_OUTBOX_ENABLED=true
N8N_OUTBOX_POLL_MS=5000

# Cohere
COHERE_API_KEY=
# Vérifier le modèle actif auprès de Cohere avant production.
COHERE_MODEL=command-a-03-2025
AI_SCORE_WEIGHT_TECHNICAL=0.5
AI_SCORE_WEIGHT_COMMUNICATION=0.2
AI_SCORE_WEIGHT_SENIORITY=0.3

# Initialisation optionnelle des comptes de développement
APP_INIT_CREATE_DEFAULT_USERS=false
APP_DEFAULT_ADMIN_USERNAME=admin
APP_DEFAULT_ADMIN_PASSWORD=
APP_DEFAULT_ADMIN_EMAIL=
APP_DEFAULT_HR_USERNAME=rh
APP_DEFAULT_HR_PASSWORD=
APP_DEFAULT_HR_EMAIL=
APP_DEFAULT_CANDIDATE_USERNAME=candidat
APP_DEFAULT_CANDIDATE_PASSWORD=
APP_DEFAULT_CANDIDATE_EMAIL=
